spring.application.name=cofshop
spring.profiles.include=key

spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}

spring.jpa.hibernate.ddl-auto=${JPA_DDL_AUTO:validate}
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.properties.hibernate.jdbc.time_zone=Asia/Seoul
spring.jpa.properties.hibernate.default_batch_fetch_size=100

# 스키마 변경은 src/main/resources/db/migration의 Flyway 스크립트로 관리
spring.flyway.baseline-on-migrate=${FLYWAY_BASELINE_ON_MIGRATE:false}
spring.flyway.baseline-version=1

spring.redis.host=${REDIS_HOST:localhost}
spring.redis.port=${REDIS_PORT:6379}
spring.redis.password=${REDIS_PASSWORD:}
spring.redis.ssl.enabled=${REDIS_SSL_ENABLED:false}

security.cors.allowed-origin-patterns=${CORS_ALLOWED_ORIGIN_PATTERNS:http://localhost:8080}

logging.pattern.level=%5p [%X{traceId:-}]

server.servlet.encoding.charset=UTF-8
server.servlet.encoding.force=true

# local: 서버 디스크(서버 1대용), s3: S3 호환 스토리지(서버 여러 대)
file.storage=${FILE_STORAGE:local}
file.dir=${FILE_DIR:./uploads}
file.s3.bucket=${FILE_S3_BUCKET:}
file.s3.region=${FILE_S3_REGION:}
file.s3.endpoint=${FILE_S3_ENDPOINT:}
file.s3.access-key=${FILE_S3_ACCESS_KEY:}
file.s3.secret-key=${FILE_S3_SECRET_KEY:}
file.s3.path-style=${FILE_S3_PATH_STYLE:false}
file.s3.public-url=${FILE_S3_PUBLIC_URL:}
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=100MB
# 제한을 넘은 요청에도 연결을 끊지 않고 413으로 응답 (기본 2MB)
server.tomcat.max-swallow-size=100MB

springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.path=/swagger-ui
springdoc.swagger-ui.url=/v3/api-docs
springdoc.swagger-ui.disable-swagger-default-url=false

order.auto-confirm.after-days=7
member.login-history.retention-months=3
member.rejoin-block.days=30

coupon.outbox.enabled=true
coupon.outbox.retention-days=7
coupon.rabbit.enabled=${COUPON_RABBIT_ENABLED:false}

# 운영 엔드포인트는 관리 포트로 분리. 관리 포트를 외부에 공개하지 말 것
management.server.port=${MANAGEMENT_PORT:8081}
management.endpoints.web.exposure.include=health,prometheus
management.endpoint.health.probes.enabled=true
management.health.rabbit.enabled=${COUPON_RABBIT_ENABLED:false}
management.metrics.tags.application=${spring.application.name}
management.metrics.distribution.percentiles-histogram.http.server.requests=true

spring.rabbitmq.host=${RABBITMQ_HOST:localhost}
spring.rabbitmq.port=${RABBITMQ_PORT:5672}
spring.rabbitmq.username=${RABBITMQ_USERNAME:guest}
spring.rabbitmq.password=${RABBITMQ_PASSWORD:guest}
spring.rabbitmq.virtual-host=${RABBITMQ_VHOST:/}
